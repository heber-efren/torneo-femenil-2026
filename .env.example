# Copia este archivo como ".env.local" y llena los valores.
# Los encuentras en Supabase: botón "Connect" (arriba) o Project Settings → API Keys.
#
# Solo van aquí datos PÚBLICOS:
#   - la URL del proyecto
#   - la clave "publishable" (empieza con sb_publishable_) o la clave "anon" (legacy)
# NUNCA pongas aquí la clave "secret" / "service_role" ni la contraseña de la base de datos.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
